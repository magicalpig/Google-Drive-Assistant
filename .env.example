# Copy this file to .env and fill in your own values.

# From console.anthropic.com. Create the key inside a workspace, not for the whole organization.
ANTHROPIC_API_KEY=

# From app.pinecone.io.
PINECONE_API_KEY=

# Optional. Name of the Pinecone index that stores your passages. See "Keys" in README.md.
# Default: google-drive-assistant
PINECONE_INDEX=

# Optional. Google Sheets whose formulas Claude describes in plain English.
# See "Optional: plain-English formula descriptions" in README.md.
# Example: DESCRIBE_FORMULAS_IN=Budget 2026|Smith, J. payroll|Mileage log
DESCRIBE_FORMULAS_IN=

# Optional. Folders where answers must come from the right year, separated by |, as paths from My Drive.
# Normally, when a question mentions a year, files with other years in their path are only moved down in
# the results. In these folders (and their subfolders), they're left out.
# Example: STRICT_YEAR_FOLDERS=Tax|Car/Honda
# Default: none
STRICT_YEAR_FOLDERS=

# Optional. Folders whose files are never loaded (including files in their subfolders), separated by |.
# Write each as its path from My Drive. Ones loaded earlier are removed from Pinecone.
# Example: IGNORE_FOLDERS=Old stuff|Work/Archive|Tax/Tax 2023
# Default: none
IGNORE_FOLDERS=

# Optional. Claude model that answers questions.
# Default: claude-haiku-5-5
CLAUDE_MODEL=

# Optional. Claude model that describes spreadsheet formulas during the ingestion phase.
# Default: claude-opus-5-5
DESCRIBE_MODEL=

# Optional. Prices for the model in DESCRIBE_MODEL, written as
# <dollars per million tokens sent>, <dollars per million tokens received>
# This gives you an estimate of what it cost you to have DESCRIBE_MODEL analyze your spreadsheet formulas.
# If you change DESCRIBE_MODEL, it's up to you to find the costs for the model you chose.
# Default: 4,20 
DESCRIBE_PRICES=

# Optional. Embedding model from Hugging Face (any model the sentence-transformers library can load).
# After changing it, run ingest.py: every file is stored again with the new model.
# Default: BAAI/bge-base-en-v1.5
EMBEDDING_MODEL=

# Optional. Text put in front of each question before it's embedded, if the model's makers recommend one.
# Default: bge models get "Represent this sentence for searching relevant passages:", others none.
QUESTION_PREFIX=
